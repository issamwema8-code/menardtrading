# ============================================================
# MENARD TRADING CC - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

SECRET_KEY=your-django-secret-key-here
DEBUG=True
BASE_URL=https://menardtrading.com

# ============================================================
# BREVO & DEPARTMENTAL EMAIL CONFIGURATION
# ============================================================
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_FALLBACK_PORT=2525
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASSWORD=your-brevo-smtp-password

# Mailbox Password for Menard Trading departmental accounts
EMAIL_PASSWORD=your-email-password

# ============================================================
# WEBHOOK & SECURITY CONFIGURATION
# ============================================================
BREVO_WEBHOOK_SECRET=your-webhook-secret-token
